NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bpas_db?schema=public"

# Generate a random secret with at least 32 characters; do not commit real secrets.
JWT_ACCESS_SECRET=
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=bpas-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30